/**
 * ============================================================
 * Secure Password Database Generator - Main Worker Entry Point
 * Version: 0.1.0-beta.1
 * Author: Andras I. Szilasi <boldwelderwx@icloud.com>
 * ============================================================
 * 
 * CLOUDFLARE WORKER BELÉPÉSI PONT
 * 
 * Ez a fő fájl, amit a Cloudflare Workers futtat.
 * Minden HTTP kérés ide érkezik először.
 * 
 * ROUTE-OK:
 *   GET /              - Üdvözlő oldal (HTML)
 *   GET /health        - Egészség ellenőrzés (JSON)
 *   GET /presets       - Összes preset listája (JSON)
 *   GET /preset/:name  - CSV letöltés (streaming, gzip)
 *   GET /info/:name    - Tanácsadás (text/plain)
 *   GET /categories    - Kategóriák listája (JSON)
 * 
 * BIZTONSÁG:
 *   - TLS 1.3 enforcement (Cloudflare alapból csinálja)
 *   - Rate limiting (IP-alapú, egyszerű counter)
 *   - Security header-ek (CORS, X-Frame-Options, stb.)
 * 
 * BŐVÍTÉS:
 * Új route hozzáadásához adj hozzá egy új app.get() sort.
 */

import { Hono } from 'hono';
import { getPreset, listPresets, getPresetsByCategory, getCategories, getPresetStats } from './presets.js';
import { createCSVStream, generateFilename, generateMetadata } from './csvBuilder.js';
import { buildAdvice, buildQuickAdvice, buildCategoryAdvice } from './advisor.js';

// ============================================================
// KONSTANSOK
// ============================================================

/** Worker verzió - fontos a verziókezelés miatt */
const VERSION = '0.1.0-beta.1';

/** Worker név (header-ekben jelenik meg) */
const SERVICE_NAME = 'Secure Password Generator';

/** Rate limiting konfiguráció */
const RATE_LIMIT = {
  WINDOW_MS: 60 * 1000,      // 1 perc
  MAX_REQUESTS: 100,          // max 100 kérés percenként IP-nként
  MAX_DOWNLOAD_REQUESTS: 10,  // max 10 letöltés percenként IP-nként
};

// ============================================================
// RATE LIMITING (egyszerű in-memory megoldás)
// ============================================================

/**
 * Egyszerű rate limiter Map-pel
 * 
 * FIGYELEM: Ez a megközelzés nem tökéletes Cloudflare Workers-nél,
 * mert a Worker instance-ek elszigeteltek lehetnek.
 * Produkciós használathoz ajánlott:
 * - Cloudflare Rate Limiting szabályok (Dashboard-ban)
 * - Cloudflare KV alapú rate limiter
 * 
 * Ez a megoldás alap védelemnek elég a BETA verzióhoz.
 */
const rateLimitMap = new Map();

/**
 * Rate limit ellenőrzés
 * @param {string} key - IP cím vagy más azonosító
 * @param {number} maxRequests - Max kérések száma
 * @returns {boolean} true ha engedélyezett
 */
function checkRateLimit(key, maxRequests) {
  const now = Date.now();
  const entry = rateLimitMap.get(key);
  
  // Ha nincs bejegyzés vagy lejárt, újat hozunk létre
  if (!entry || now - entry.windowStart > RATE_LIMIT.WINDOW_MS) {
    rateLimitMap.set(key, {
      windowStart: now,
      count: 1,
      downloadCount: key.includes('download') ? 1 : 0,
    });
    return true;
  }
  
  // Ha letöltés, külön számláló
  if (key.includes('download')) {
    if (entry.downloadCount >= RATE_LIMIT.MAX_DOWNLOAD_REQUESTS) {
      return false;
    }
    entry.downloadCount++;
    entry.count++;
    return true;
  }
  
  // Normál kérés
  if (entry.count >= maxRequests) {
    return false;
  }
  entry.count++;
  return true;
}

/**
 * Régi bejegyzések takarítása (memória felszabadítás)
 * Minden 5 percben fut
 */
setInterval(() => {
  const now = Date.now();
  for (const [key, entry] of rateLimitMap.entries()) {
    if (now - entry.windowStart > RATE_LIMIT.WINDOW_MS * 2) {
      rateLimitMap.delete(key);
    }
  }
}, 5 * 60 * 1000);

// ============================================================
// SEGÉDFÜGGVÉNYEK
// ============================================================

/**
 * Biztonsági header-ek hozzáadása a válaszhoz
 * @param {Response} response - Válasz objektum
 * @returns {Response} Válasz biztonsági header-ekkel
 */
function addSecurityHeaders(response) {
  const headers = new Headers(response.headers);
  
  // Alap biztonsági header-ek
  headers.set('X-Content-Type-Options', 'nosniff');
  headers.set('X-Frame-Options', 'DENY');
  headers.set('X-XSS-Protection', '1; mode=block');
  headers.set('Referrer-Policy', 'strict-origin-when-cross-origin');
  
  // Szolgáltatás azonosító header-ek
  headers.set('X-Service-Name', SERVICE_NAME);
  headers.set('X-Service-Version', VERSION);
  
  // TLS 1.3 jelzés (Cloudflare alapból enforcementálja, de jelezzük)
  headers.set('X-TLS-Version', '1.3');
  headers.set('X-TLS-Enforcement', 'strict');
  
  return new Response(response.body, {
    status: response.status,
    statusText: response.statusText,
    headers,
  });
}

/**
 * JSON válasz generálása
 * @param {Object} data - Válasz adat
 * @param {number} status - HTTP státusz kód
 * @param {Object} extraHeaders - Extra header-ek
 * @returns {Response} JSON válasz
 */
function jsonResponse(data, status = 200, extraHeaders = {}) {
  const response = new Response(JSON.stringify(data, null, 2), {
    status,
    headers: {
      'Content-Type': 'application/json; charset=utf-8',
      ...extraHeaders,
    },
  });
  return addSecurityHeaders(response);
}

/**
 * Hiba válasz generálása
 * @param {string} message - Hibaüzenet
 * @param {number} status - HTTP státusz kód
 * @returns {Response} Hiba válasz
 */
function errorResponse(message, status = 400) {
  return jsonResponse({
    error: true,
    message,
    version: VERSION,
    timestamp: new Date().toISOString(),
  }, status);
}

/**
 * Rate limit hiba válasz
 * @returns {Response} 429 válasz
 */
function rateLimitResponse() {
  return errorResponse(
    'Rate limit exceeded. Please try again in 1 minute. ' +
    'Rate limit: 100 requests/minute, 10 downloads/minute.',
    429
  );
}

// ============================================================
// HONO APP LÉTREHOZÁSA
// ============================================================

const app = new Hono();

// ============================================================
// MIDDLEWARE-ek
// ============================================================

/**
 * Rate limiting middleware
 * Minden kérésre fut
 */
app.use('*', async (c, next) => {
  const ip = c.req.header('CF-Connecting-IP') || 'unknown';
  const path = c.req.path;
  
  // Letöltés kérések külön számlálóval
  const key = path.startsWith('/preset/') ? `download:${ip}` : ip;
  
  if (!checkRateLimit(key, RATE_LIMIT.MAX_REQUESTS)) {
    return c.json({
      error: true,
      message: 'Rate limit exceeded. Please try again in 1 minute.',
      version: VERSION,
    }, 429);
  }
  
  await next();
});

/**
 * Security headers middleware
 * Minden válaszhoz hozzáadja a biztonsági header-eket
 */
app.use('*', async (c, next) => {
  await next();
  
  // Biztonsági header-ek hozzáadása
  const headers = new Headers(c.res.headers);
  headers.set('X-Content-Type-Options', 'nosniff');
  headers.set('X-Frame-Options', 'DENY');
  headers.set('X-XSS-Protection', '1; mode=block');
  headers.set('Referrer-Policy', 'strict-origin-when-cross-origin');
  headers.set('X-Service-Name', SERVICE_NAME);
  headers.set('X-Service-Version', VERSION);
  headers.set('X-TLS-Version', '1.3');
  
  c.res = new Response(c.res.body, {
    status: c.res.status,
    statusText: c.res.statusText,
    headers,
  });
});

/**
 * CORS middleware (minden origin engedélyezése BETA verzióban)
 * Produkciós verzióban érdemes leszűkíteni
 */
app.use('*', async (c, next) => {
  const origin = c.req.header('Origin');
  if (origin) {
    c.header('Access-Control-Allow-Origin', '*');
    c.header('Access-Control-Allow-Methods', 'GET, OPTIONS');
    c.header('Access-Control-Allow-Headers', 'Content-Type');
  }
  await next();
});

// ============================================================
// ROUTE-OK
// ============================================================

