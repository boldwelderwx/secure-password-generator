/**
 * GET /health - Egészség ellenőrzés
 * JSON formátumban adja vissza a rendszer állapotát
 */
app.get('/health', (c) => {
  const stats = getPresetStats();
  
  return c.json({
    status: 'healthy',
    version: VERSION,
    timestamp: new Date().toISOString(),
    service: SERVICE_NAME,
    presets: stats.total_presets,
    categories: stats.category_list.length,
    max_length: stats.max_length,
    max_count: stats.max_count,
    rate_limit: {
      window_ms: RATE_LIMIT.WINDOW_MS,
      max_requests: RATE_LIMIT.MAX_REQUESTS,
      max_downloads: RATE_LIMIT.MAX_DOWNLOAD_REQUESTS,
    },
    features: {
      tls_1_3: true,
      streaming: true,
      compression: true,
      multi_language: false, // BETA: még nincs többnyelvű támogatás
    },
  });
});

/**
 * GET /presets - Összes preset listája
 * JSON formátumban adja vissza az összes elérhető presetet
 */
app.get('/presets', (c) => {
  const presets = listPresets();
  const categories = getCategories();
  
  return c.json({
    version: VERSION,
    timestamp: new Date().toISOString(),
    total: presets.length,
    categories: categories,
    presets: presets,
    usage_example: {
      command: 'curl --tlsv1.3 --compressed "URL/preset/email-32-10k" -o passwords.csv',
      info_command: 'curl -s "URL/info/email-32-10k"',
    },
  });
});

/**
 * GET /categories - Kategóriák listája
 * JSON formátumban adja vissza az összes kategóriát
 */
app.get('/categories', (c) => {
  const categories = getCategories();
  
  const categoryInfo = categories.map(cat => ({
    name: cat,
    presets: getPresetsByCategory(cat).map(p => p.name),
  }));
  
  return c.json({
    version: VERSION,
    timestamp: new Date().toISOString(),
    total: categories.length,
    categories: categoryInfo,
  });
});

/**
 * GET /preset/:name - CSV letöltés (streaming, gzip)
 * 
 * Ez a fő endpoint - a felhasználó ezzel tölti le a jelszó-adatbázist.
 * 
 * PÉLDA:
 *   curl --tlsv1.3 --compressed --progress-bar \
 *     "https://passgen.boldwelderwx.workers.dev/preset/email-32-10k" \
 *     -o passwords.csv
 * 
 * FOLYAMAT:
 * 1. Preset validálás
 * 2. Streaming CSV generálás (memória-hatékony)
 * 3. gzip tömörítés (Cloudflare automatikusan csinálja)
 * 4. Válasz küldése chunk-onként
 */
app.get('/preset/:name', (c) => {
  const presetName = c.req.param('name');
  
  // Preset validálás
  const preset = getPreset(presetName);
  
  if (!preset) {
    return c.json({
      error: true,
      message: `Preset not found: ${presetName}`,
      available_presets: 'GET /presets for full list',
      version: VERSION,
    }, 404);
  }
  
  // Streaming CSV generálás
  const csvStream = createCSVStream(preset, presetName);
  const filename = generateFilename(presetName);
  const metadata = generateMetadata(preset, presetName, VERSION);
  
  // Válasz létrehozása streaming-mel
  const response = new Response(csvStream, {
    status: 200,
    headers: {
      'Content-Type': 'text/csv; charset=utf-8',
      'Content-Disposition': `attachment; filename="${filename}"`,
      // Cloudflare automatikusan tömörít, de explicit beállítjuk
      // hogy a kliens tudja, mire számítson
      'Cache-Control': 'no-cache, no-store, must-revalidate',
      'Pragma': 'no-cache',
      'Expires': '0',
      // Metadata header-ekben (későbbi feldolgozáshoz)
      'X-Preset-Name': presetName,
      'X-Preset-Length': String(preset.length),
      'X-Preset-Count': String(preset.count),
      'X-Preset-Charset': Array.isArray(preset.charset) 
        ? preset.charset.join('+') 
        : preset.charset,
      'X-Generator-Version': VERSION,
      'X-Generated-At': metadata.generated_at,
    },
  });
  
  return addSecurityHeaders(response);
});

/**
 * GET /info/:name - Tanácsadás (text/plain)
 * 
 * Ez az endpoint adja vissza a formázott tanácsadást,
 * amit a felhasználó a letöltés után lát a konzolban.
 * 
 * PÉLDA:
 *   curl -s "https://passgen.boldwelderwx.workers.dev/info/email-32-10k"
 * 
 * HASZNÁLAT A FELHASZNÁLÓI OLDALON:
 *   curl --tlsv1.3 --compressed "URL/preset/email-32-10k" -o passwords.csv \
 *     && curl -s "URL/info/email-32-10k"
 */
app.get('/info/:name', (c) => {
  const presetName = c.req.param('name');
  
  // Tanácsadás generálása
  const baseUrl = new URL(c.req.url).origin;
  const advice = buildAdvice(presetName, {
    baseUrl,
    version: VERSION,
    lang: 'hu', // BETA: magyar, később többnyelvű
  });
  
  return c.text(advice, 200, {
    'Content-Type': 'text/plain; charset=utf-8',
    'Cache-Control': 'no-cache',
    'X-Generator-Version': VERSION,
  });
});

/**
 * OPTIONS kérések kezelése (CORS preflight)
 */
app.options('*', (c) => {
  return c.text('', 204, {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type',
  });
});

// ============================================================
// 404 KEZELŐ
// ============================================================

/**
 * Nem található route-ok kezelése
 */
app.notFound((c) => {
  return c.json({
    error: true,
    message: 'Endpoint not found',
    available_endpoints: [
      'GET /          - Üdvözlő oldal (HTML)',
      'GET /health    - Egészség ellenőrzés (JSON)',
      'GET /presets   - Összes preset listája (JSON)',
      'GET /preset/:name - CSV letöltés (streaming)',
      'GET /info/:name   - Tanácsadás (text/plain)',
      'GET /categories   - Kategóriák listája (JSON)',
    ],
    version: VERSION,
  }, 404);
});

/**
 * Hiba kezelő middleware
 */
app.onError((err, c) => {
  console.error(`Error in worker: ${err.message}`, err.stack);
  
  return c.json({
    error: true,
    message: 'Internal server error',
    detail: err.message, // BETA: fejlesztési fázisban mutatjuk a részleteket
    version: VERSION,
  }, 500);
});

// ============================================================
// EXPORT
// ============================================================

/**
 * Cloudflare Worker export
 * 
 * A Workers runtime ezt a fetch függvényt hívja minden kérésnél.
 * 
 * @param {Request} request - HTTP kérés
 * @param {Object} env - Cloudflare environment (bindings)
 * @param {Object} ctx - Execution context
 * @returns {Promise<Response>} HTTP válasz
 */
export default {
  fetch: app.fetch,
};
