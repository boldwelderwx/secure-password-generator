    },
    {
      "en": "Use different keyfiles for different purposes",
      "hu": "Használj különböző kulcsfájlokat különböző célokra"
    },
    {
      "en": "Backup the keyfile in multiple secure locations",
      "hu": "Mentsd a kulcsfájlt több biztonságos helyre"
    }
  ]
