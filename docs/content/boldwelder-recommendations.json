  "openssl_passfile_examples": [
    {
      "tool": "Generate 4096-char Master Key File",
      "description_en": "Create a master key file to use with all your encryption tools",
      "description_hu": "Hozz létre egy mester kulcsfájlt az összes titkosító eszközödhöz",
      "commands": [
        "# Generate 4096-char password from the Worker:",
        "curl -s 'https://secure-password-generator.boldwelderwx.workers.dev/preset/extreme-4096-100k' | head -2 | tail -1 > master.key",
        "",
        "# Verify the length:",
        "wc -c master.key  # Should show 4096"
      ]
    },
    {
      "tool": "OpenSSL AES-256-CBC with Password File",
      "description_en": "Encrypt files using -pass file: syntax",
      "description_hu": "Fájlok titkosítása -pass file: szintaxissal",
      "commands": [
        "# Encrypt a document:",
        "openssl enc -aes-256-cbc -salt -pbkdf2 -iter 1000000 \\",
        "  -in secret.pdf -out secret.enc \\",
        "  -pass file:master.key",
        "",
        "# Decrypt:",
        "openssl enc -d -aes-256-cbc -pbkdf2 -iter 1000000 \\",
        "  -in secret.enc -out secret.pdf \\",
        "  -pass file:master.key"
      ]
    },
    {
      "tool": "GPG Symmetric with Passphrase File",
      "description_en": "Encrypt using GPG with --passphrase-file",
      "description_hu": "Titkosítás GPG-vel --passphrase-file opcióval",
      "commands": [
        "# Encrypt:",
        "gpg --symmetric --cipher-algo AES256 \\",
        "  --passphrase-file master.key \\",
        "  --batch --yes \\",
        "  -o secret.pdf.gpg secret.pdf",
        "",
        "# Decrypt:",
        "gpg --decrypt \\",
        "  --passphrase-file master.key \\",
        "  --batch \\",
        "  -o secret.pdf secret.pdf.gpg"
      ]
    },
    {
      "tool": "LUKS Full Disk Encryption",
      "description_en": "Add keyfile to LUKS for fast unlocking",
      "description_hu": "Kulcsfájl hozzáadása LUKS-hoz gyors feloldásért",
      "commands": [
        "# Add keyfile to existing LUKS partition:",
        "sudo cryptsetup luksAddKey /dev/sda1 master.key",
        "",
        "# Open with keyfile (no password prompt):",
        "sudo cryptsetup luksOpen /dev/sda1 crypt \\",
        "  --key-file master.key"
      ]
    }
  ],
