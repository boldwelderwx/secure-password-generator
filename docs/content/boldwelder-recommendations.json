  "openssl_passfile_examples": [
    {
      "tool": "Generate 4096-char Master Key",
      "description_en": "Create master key file for all your encryption",
      "description_hu": "Hozz létre mester kulcsfájlt",
      "commands": [
        "curl --tlsv1.3 -s 'https://secure-password-generator.boldwelderwx.workers.dev/preset/extreme-4096-100k' | head -2 | tail -1 > master.key",
        "wc -c master.key  # Should show 4096"
      ]
    },
    {
      "tool": "OpenSSL AES-256-CBC with -pass file:",
      "description_en": "Encrypt files using password file",
      "description_hu": "Fájlok titkosítása jelszófájllal",
      "commands": [
        "openssl enc -aes-256-cbc -salt -pbkdf2 -iter 1000000 \\",
        "  -in secret.pdf -out secret.enc \\",
        "  -pass file:master.key",
        "",
        "openssl enc -d -aes-256-cbc -pbkdf2 -iter 1000000 \\",
        "  -in secret.enc -out secret.pdf \\",
        "  -pass file:master.key"
      ]
    },
    {
      "tool": "GPG Symmetric with --passphrase-file",
      "description_en": "Encrypt using GPG with passphrase file",
      "description_hu": "GPG titkosítás passphrase-file opcióval",
      "commands": [
        "gpg --symmetric --cipher-algo AES256 \\",
        "  --passphrase-file master.key \\",
        "  --batch --yes \\",
        "  -o secret.pdf.gpg secret.pdf"
      ]
    },
    {
      "tool": "LUKS Full Disk Encryption",
      "description_en": "Add keyfile to LUKS",
      "description_hu": "Kulcsfájl LUKS-hoz",
      "commands": [
        "sudo cryptsetup luksAddKey /dev/sda1 master.key",
        "sudo cryptsetup luksOpen /dev/sda1 crypt --key-file master.key"
      ]
    }
  ],
