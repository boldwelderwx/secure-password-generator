    {
      "en": "Brute-force impossible",
      "hu": "Brute-force lehetetlen"
    },
    {
      "en": "Fits in memory easily",
      "hu": "Könnyen elfér memóriában"
    },
    {
      "en": "Easy to store in text file",
      "hu": "Könnyű fájlban tárolni"
    },
    {
      "en": "Generated in milliseconds",
      "hu": "Milliszekundumok alatt generálható"
    }
