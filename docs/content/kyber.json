{
  "title": "Kyber / ML-KEM",
  "intro": {
    "en": "ML-KEM (formerly Kyber) is the NIST FIPS 203 standard for post-quantum key encapsulation. OpenSSL 3.5+ (April 2025) supports it natively - no third-party provider needed!",
    "hu": "Az ML-KEM (korábban Kyber) a NIST FIPS 203 szabvány. Az OpenSSL 3.5+ natívan támogatja!"
  },
  "why_kyber": [
    {
      "en": "NIST FIPS 203 standard",
      "hu": "NIST FIPS 203 szabvány"
    },
    {
      "en": "Quantum-resistant",
      "hu": "Kvantum-ellenálló"
    },
    {
      "en": "Native in OpenSSL 3.5+",
      "hu": "Natív OpenSSL 3.5+-ban"
    },
    {
      "en": "Used by Signal, Apple, Cloudflare",
      "hu": "Signal, Apple, Cloudflare használja"
    },
    {
      "en": "Hybrid mode: X25519 + ML-KEM-768",
      "hu": "Hibrid mód: X25519 + ML-KEM-768"
    }
  ],
  "kyber_variants": [
    {
      "name": "ML-KEM-512",
      "security": "AES-128",
      "use": "Fast",
      "pubkey": "800B",
      "privkey": "1632B",
      "ciphertext": "768B"
    },
    {
      "name": "ML-KEM-768",
      "security": "AES-192",
