      "pubkey": "1184B",
      "privkey": "2400B",
      "ciphertext": "1088B"
    },
    {
      "name": "ML-KEM-1024",
      "security": "AES-256",
      "use": "Maximum",
      "pubkey": "1568B",
      "privkey": "3168B",
      "ciphertext": "1568B"
    }
  ],
  "examples": [
    {
      "tool": "OpenSSL 3.5+ (Native ML-KEM)",
      "note_en": "OpenSSL 3.5 (April 2025) ships ML-KEM natively. Compile from source for the latest!",
      "note_hu": "Az OpenSSL 3.5 natívan tartalmazza az ML-KEM-et. Compile source-ról a legújabbért!",
      "commands": [
        "# Check version (need 3.5+):",
        "openssl version",
        "",
        "# Generate ML-KEM-768 keypair:",
        "openssl genpkey -algorithm ml-kem-768 -out mlkem768_priv.pem",
        "",
        "# Extract public key:",
        "openssl pkey -in mlkem768_priv.pem -pubout -out mlkem768_pub.pem",
        "",
        "# Encapsulate (Alice creates shared secret):",
        "openssl pkeyutl -encapsulate -pubin -inkey mlkem768_pub.pem \\",
        "  -out ciphertext.bin -out secret_alice.bin",
        "",
        "# Decapsulate (Bob recovers secret):",
        "openssl pkeyutl -decapsulate -inkey mlkem768_priv.pem \\",
        "  -in ciphertext.bin -out secret_bob.bin"
      ]
    },
    {
      "tool": "Hybrid TLS 1.3 (X25519 + ML-KEM-768)",
      "note_en": "Best practice: hybrid key exchange for both classical and quantum security.",
      "note_hu": "Legjobb gyakorlat: hibrid kulcs klasszikus + kvantum biztonságért.",
      "commands": [
        "# Connect with hybrid post-quantum TLS:",
        "openssl s_client -connect cloudflare.com:443 \\",
        "  -groups x25519_mlkem768 -brief"
      ]
    },
    {
      "tool": "Cloudflare Native Support",
      "note_en": "Cloudflare's edge supports post-quantum TLS by default!",
      "note_hu": "A Cloudflare alapból támogatja a poszt-kvantum TLS-t!",
      "commands": [
        "# Test if Cloudflare offers ML-KEM:",
        "curl -vI https://cloudflare.com 2>&1 | grep -i 'kyber\\|ml-kem'"
      ]
    }
  ]
}