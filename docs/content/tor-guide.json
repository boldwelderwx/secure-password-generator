      "security": "High",
      "use_case": "Strong anonymity",
      "commands": [
        "# Install Tor:",
        "sudo apt install tor torsocks",
        "",
        "# Start Tor service:",
        "sudo systemctl start tor",
        "",
        "# Use torsocks wrapper:",
        "torsocks curl --compressed https://secure-password-generator.boldwelderwx.workers.dev/preset/military-nato-256-10k -o pw.csv",
        "",
        "# Or use 'torify' alias:",
        "torify curl --compressed https://secure-password-generator.boldwelderwx.workers.dev/preset/crypto-wallet-128-10k -o pw.csv"
      ]
    },
    {
      "level": 3,
      "name": "Proxychains",
      "security": "Very High",
      "use_case": "Advanced anonymity",
      "commands": [
        "sudo apt install proxychains4",
        "sudo nano /etc/proxychains.conf",
        "# Add: socks5 127.0.0.1 9050 (Tor)",
        "",
        "proxychains4 curl --compressed https://secure-password-generator.boldwelderwx.workers.dev/preset/military-secret-512-50k -o pw.csv"
      ]
