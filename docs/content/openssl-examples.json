  "boldwelder_method": {
    "en": "Boldwelder's Method: Always use 4096-character password files with -passfile option",
    "hu": "Boldwelder módszere: Mindig 4096 karakteres jelszófájlokat használj -passfile opcióval",
    "commands": [
      "# Generate 4096-char password file:",
      "curl --tlsv1.3 -s 'https://secure-password-generator.boldwelderwx.workers.dev/preset/extreme-4096-100k' | head -2 | tail -1 > master.key",
      "",
      "# All examples below use: -pass file:master.key"
    ]
  },
  "encryption_types": [
    {
      "name": "AES-256-CBC",
      "use": "General file encryption",
      "security": "Strong (256-bit)",
      "who_uses": "Everyone - industry standard",
      "commands": [
        "# Encrypt:",
        "openssl enc -aes-256-cbc -salt -pbkdf2 -iter 1000000 \\",
        "  -in secret.txt -out secret.enc \\",
        "  -pass file:master.key",
        "",
        "# Decrypt:",
        "openssl enc -d -aes-256-cbc -pbkdf2 -iter 1000000 \\",
        "  -in secret.enc -out secret.txt \\",
        "  -pass file:master.key"
      ]
    },
    {
